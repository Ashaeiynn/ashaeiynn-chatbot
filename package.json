{
  "name": "video-chatbot",
  "version": "1.0.0",
  "description": "Website chatbot that answers questions from your video library",
  "type": "module",
  "scripts": {
    "process": "node pipeline/run-all.mjs",
    "articles": "node pipeline/4-articles.mjs",
    "ingest": "node pipeline/3-ingest.mjs",
    "start": "node server/server.mjs",
    "compare": "node server/compare.mjs",
    "test:retrieval": "node tests/retrieval-check.mjs",
    "test:answers": "node tests/answer-check.mjs",
    "download": "node pipeline/1-download.mjs",
    "transcribe": "node pipeline/2-transcribe.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@huggingface/transformers": "^4.2.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "onnxruntime-node": "1.23.0"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true,
    "onnxruntime-node@1.23.0": true
  }
}
