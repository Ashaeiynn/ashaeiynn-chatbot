# Secrets — never commit
.env

# Machine-local files — never sync between computers
.DS_Store
.claude/settings.local.json
.claude/launch.json

# Dependencies
node_modules/

# Bulky/transient pipeline files (re-creatable)
data/audio/
data/run-all.log

# data/transcripts/ ARE committed on purpose — the precious source text (~64h of
# transcription); the repo doubles as their backup, and every machine rebuilds
# its OWN knowledge.db from them.
# data/knowledge.db is NOT committed (2026-07-22): it is a rebuildable artifact
# built from the transcripts. Syncing the big binary DB over git kept tangling
# between machines and rolling back (articles "vanished" from memory even though
# their text was safe). Each machine now builds its own DB from the transcripts,
# so the active memory can never drift or roll back — worst case, it just rebuilds.
data/knowledge.db
data/questions.log
data/thought.json
data/push-subs.json
data/push-log.json
data/push-state.json
data/push-queue.json
data/announcement.json
data/users.json
data/suggestions.json
data/uploads/
data/teach-queue.json
models/**/model_quantized.onnx
data/server-agent.log
data/titling.log
data/stt-usage.json
data/stt-review.json
