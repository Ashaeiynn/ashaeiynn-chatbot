# Secrets — never commit
.env

# Machine-local files — never sync between computers
.DS_Store
.claude/settings.local.json
.claude/launch.json

# Dependencies
node_modules/

# Bulky/transient pipeline files (re-creatable)
data/audio/
data/run-all.log

# NOTE: data/knowledge.db and data/transcripts/ ARE committed on purpose —
# the deploy needs the knowledge base, and the transcripts are the precious
# output of ~64h of transcription (the repo doubles as their backup).
data/questions.log
data/uploads/
data/teach-queue.json
models/**/model_quantized.onnx
data/server-agent.log
data/titling.log
