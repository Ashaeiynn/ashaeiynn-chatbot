{
  "title": "farak new1-20",
  "url": "",
  "videoId": "audio_mrjva6pr-farak-new1-20",
  "language": "hi",
  "minutes": 1,
  "segments": [
    {
      "start": 0,
      "end": 2,
      "text": "जैसी आरम सभीको"
    },
    {
      "start": 2,
      "end": 4,
      "text": "साधना में स्वास का महत"
    },
    {
      "start": 4,
      "end": 7,
      "text": "मन और स्वास एक दूसरे से गहराई से जुड़े हुग दिए"
    },
    {
      "start": 7,
      "end": 10,
      "text": "हात्योग प्रधिपिका में कहा गया है"
    },
    {
      "start": 10,
      "end": 13,
      "text": "चले वाते चलम चितम, निशचले निशचलम भवे"
    },
    {
      "start": 13,
      "end": 16,
      "text": "यानि जब जब स्वास इस्थिर होती है"
    },
    {
      "start": 16,
      "end": 17,
      "text": "तो मन भेस्थिर हो जाता है"
    },
    {
      "start": 17,
      "end": 20,
      "text": "अगर हम अपने ध्यान और पूजन की शुरुआत करने से पहले"
    },
    {
      "start": 20,
      "end": 23,
      "text": "उसी इस्थान पर थोड़ा प्रणायम कर लें"
    },
    {
      "start": 23,
      "end": 25,
      "text": "जैसे की भ्रामरी या भ्रस्तिका"
    },
    {
      "start": 25,
      "end": 27,
      "text": "तो हमारी साधना और सहज हो जाती है"
    },
    {
      "start": 27,
      "end": 29,
      "text": "और लंबे समय तक इस्थिर का बनी रहती है"
    },
    {
      "start": 29,
      "end": 32,
      "text": "आशा है इस चर्चा से आपको साहता मिली"
    },
    {
      "start": 32,
      "end": 33,
      "text": "जैसी आरा"
    }
  ]
}