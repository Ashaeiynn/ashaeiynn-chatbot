{
  "title": "Keno Upanishad",
  "url": "https://vimeo.com/934431544",
  "videoId": "934431544",
  "language": "hi",
  "minutes": 8,
  "segments": [
    {
      "start": 0,
      "end": 9,
      "text": "जैस याराब"
    },
    {
      "start": 9,
      "end": 13,
      "text": "तो आज हम बात करेंगे केनो उपनिशद पर"
    },
    {
      "start": 13,
      "end": 18,
      "text": "केनो उपनिशद सामवेद के तलकवार ब्राह्मन के नवे अध्या से लिया गया है"
    },
    {
      "start": 18,
      "end": 22,
      "text": "इस उपनिशद में वैसे तो चार खंड है"
    },
    {
      "start": 22,
      "end": 26,
      "text": "प्रतम खंड में"
    },
    {
      "start": 26,
      "end": 29,
      "text": "इसमें गुरु महिमा"
    },
    {
      "start": 29,
      "end": 32,
      "text": "और गुरु परंपरा के बारे में बताया गया है"
    },
    {
      "start": 32,
      "end": 36,
      "text": "साथ ही उपास से ब्रह्मा के बारे में"
    },
    {
      "start": 36,
      "end": 41,
      "text": "बहुत ही अच्छे से निरुपन किया गया है"
    },
    {
      "start": 41,
      "end": 45,
      "text": "अब गुरु महिमा क्या है"
    },
    {
      "start": 45,
      "end": 49,
      "text": "तो गुरु अर्था"
    },
    {
      "start": 49,
      "end": 53,
      "text": "जो आपको सही मार्ग डर्शन दे"
    },
    {
      "start": 53,
      "end": 58,
      "text": "जो आपके अध्याक्मिक क्यात्रा में"
    },
    {
      "start": 58,
      "end": 60,
      "text": "आपके साथ रहे"
    },
    {
      "start": 60,
      "end": 62,
      "text": "आपको सही मार्ग डर्शन दे"
    },
    {
      "start": 62,
      "end": 65,
      "text": "वही गुरु होता है"
    },
    {
      "start": 65,
      "end": 68,
      "text": "अब इसमें बताया गया है"
    },
    {
      "start": 68,
      "end": 71,
      "text": "हम पहले उस पर बात करते है"
    },
    {
      "start": 71,
      "end": 73,
      "text": "सर्वप्रतम"
    },
    {
      "start": 73,
      "end": 76,
      "text": "के नोपनिशाद में यह बताया गया है"
    },
    {
      "start": 76,
      "end": 78,
      "text": "कि उपास से ब्रह्मा"
    },
    {
      "start": 78,
      "end": 80,
      "text": "अर्था जिस ब्रह्मा की हम उपास ना कर रहे हैं"
    },
    {
      "start": 80,
      "end": 82,
      "text": "जिस ब्रह्मा को हम जानना चाहते हैं"
    },
    {
      "start": 82,
      "end": 83,
      "text": "वह क्या है"
    },
    {
      "start": 83,
      "end": 85,
      "text": "उसे कैसे प्राप्त किया जा सकता है"
    },
    {
      "start": 85,
      "end": 87,
      "text": "तो वह ब्रह्मा"
    },
    {
      "start": 87,
      "end": 88,
      "text": "या वह"
    },
    {
      "start": 88,
      "end": 91,
      "text": "ब्रह्मा जो है वो अलग-अलग"
    },
    {
      "start": 91,
      "end": 93,
      "text": "लोक से अलग-अलग"
    },
    {
      "start": 93,
      "end": 95,
      "text": "स्थितियों से मिलकर बना है"
    },
    {
      "start": 95,
      "end": 98,
      "text": "उसी ब्रह्मा से इन सभी की उत्पत्ति हुई है"
    },
    {
      "start": 98,
      "end": 100,
      "text": "और वह इन सभी में समाही थै"
    },
    {
      "start": 100,
      "end": 102,
      "text": "तो जिस प्रकार"
    },
    {
      "start": 102,
      "end": 104,
      "text": "मनुष्य का एक"
    },
    {
      "start": 104,
      "end": 106,
      "text": "स्वभाव होता है"
    },
    {
      "start": 106,
      "end": 108,
      "text": "जिस प्रकार मनुष्य की वरत्तिया होती है"
    },
    {
      "start": 108,
      "end": 110,
      "text": "जिस प्रकार से उसका आचरण होता है"
    },
    {
      "start": 110,
      "end": 112,
      "text": "वह उसी लोक से"
    },
    {
      "start": 112,
      "end": 113,
      "text": "संबंदित होता है"
    },
    {
      "start": 113,
      "end": 114,
      "text": "साथ ही"
    },
    {
      "start": 114,
      "end": 116,
      "text": "जो हम देखते हैं"
    },
    {
      "start": 116,
      "end": 118,
      "text": "या हमने सुना है"
    },
    {
      "start": 118,
      "end": 120,
      "text": "बगवान से कृष्य ने"
    },
    {
      "start": 120,
      "end": 121,
      "text": "या भगवान से राम ने"
    },
    {
      "start": 121,
      "end": 123,
      "text": "अपने मुख में अपनी माता को"
    },
    {
      "start": 123,
      "end": 125,
      "text": "इस ब्रह्मान के दर्शन करा दिया"
    },
    {
      "start": 125,
      "end": 128,
      "text": "तो ये एक"
    },
    {
      "start": 128,
      "end": 130,
      "text": "चमतकार के साथ-साथ"
    },
    {
      "start": 130,
      "end": 132,
      "text": "एक गुडविज्यान भी है"
    },
    {
      "start": 132,
      "end": 134,
      "text": "क्योंकि यह ब्रह्मान"
    },
    {
      "start": 134,
      "end": 136,
      "text": "जो है वह आपके इस शरीर में ही"
    },
    {
      "start": 136,
      "end": 137,
      "text": "समाही थैं"
    },
    {
      "start": 137,
      "end": 139,
      "text": "पर जब आप उसे जागरित अवस्था में"
    },
    {
      "start": 139,
      "end": 141,
      "text": "प्राप्त करते हैं"
    },
    {
      "start": 141,
      "end": 142,
      "text": "समझते हैं तो आप भी"
    },
    {
      "start": 142,
      "end": 144,
      "text": "उस ब्रह्मान को"
    },
    {
      "start": 144,
      "end": 147,
      "text": "अपने अंदर दिखा सकते हैं"
    },
    {
      "start": 147,
      "end": 149,
      "text": "और देख सकते हैं"
    },
    {
      "start": 149,
      "end": 152,
      "text": "परन्तु अब ये जागरिती कैसे होगी"
    },
    {
      "start": 152,
      "end": 154,
      "text": "इस जागरिती के लिए ही"
    },
    {
      "start": 154,
      "end": 155,
      "text": "हमें गुरु सानिध्य की"
    },
    {
      "start": 155,
      "end": 158,
      "text": "गुरु के अनुसरण की आवशक्ता है"
    },
    {
      "start": 158,
      "end": 162,
      "text": "इस उपनिशद में"
    },
    {
      "start": 162,
      "end": 164,
      "text": "सबसे पहले उस उपास्य ब्रह्मा को ही"
    },
    {
      "start": 164,
      "end": 166,
      "text": "बताया गया है कि वह ब्रह्मा"
    },
    {
      "start": 166,
      "end": 168,
      "text": "सब जगह"
    },
    {
      "start": 168,
      "end": 170,
      "text": "समाहित है वही"
    },
    {
      "start": 170,
      "end": 172,
      "text": "उसी से सब की उत्पत्ति होई है"
    },
    {
      "start": 172,
      "end": 174,
      "text": "और यहाँ सब उसी में"
    },
    {
      "start": 174,
      "end": 175,
      "text": "विलीन हो जाएगा"
    },
    {
      "start": 175,
      "end": 178,
      "text": "तब पश्चाद इस उपनिशद में"
    },
    {
      "start": 178,
      "end": 181,
      "text": "मन की अवस्था"
    },
    {
      "start": 181,
      "end": 183,
      "text": "को भी बताया गया है"
    },
    {
      "start": 183,
      "end": 186,
      "text": "और उसके पश्चाद"
    },
    {
      "start": 186,
      "end": 187,
      "text": "एक छोटी सी कथा आती है"
    },
    {
      "start": 187,
      "end": 189,
      "text": "हम उसे ले लेते हैं"
    },
    {
      "start": 189,
      "end": 192,
      "text": "जब देवताओं का और असुरों का"
    },
    {
      "start": 192,
      "end": 192,
      "text": "युद्ध हुआ"
    },
    {
      "start": 192,
      "end": 195,
      "text": "युद्ध में देवताओं ने असुरों पर"
    },
    {
      "start": 195,
      "end": 196,
      "text": "विजय पराफ्त करी"
    },
    {
      "start": 196,
      "end": 198,
      "text": "तब देवताओं को"
    },
    {
      "start": 198,
      "end": 200,
      "text": "उस विजय से अभीमान हो गया"
    },
    {
      "start": 200,
      "end": 202,
      "text": "कि हमारे कारण"
    },
    {
      "start": 202,
      "end": 204,
      "text": "या हमारे ही करने से"
    },
    {
      "start": 204,
      "end": 205,
      "text": "यह ब्रम्हंड चल रहा है"
    },
    {
      "start": 205,
      "end": 209,
      "text": "इसके रक्षक, इसके भोक्ता"
    },
    {
      "start": 209,
      "end": 210,
      "text": "हम ही हैं"
    },
    {
      "start": 210,
      "end": 212,
      "text": "जब उनके अंदर इस प्रकार से"
    },
    {
      "start": 212,
      "end": 214,
      "text": "अपनी विजय के कारण"
    },
    {
      "start": 214,
      "end": 215,
      "text": "अपनी शक्तियों के करण"
    },
    {
      "start": 215,
      "end": 216,
      "text": "अभीमान हुआ"
    },
    {
      "start": 216,
      "end": 218,
      "text": "तब उनके सामने"
    },
    {
      "start": 218,
      "end": 220,
      "text": "एक यक्ष का प्रादूर्बा होता है"
    },
    {
      "start": 220,
      "end": 223,
      "text": "वह यक्ष को देखकर"
    },
    {
      "start": 223,
      "end": 225,
      "text": "देवराज इंदर"
    },
    {
      "start": 225,
      "end": 226,
      "text": "अगनी देव से कहता है"
    },
    {
      "start": 226,
      "end": 228,
      "text": "कि जाओ, उसे पूछो"
    },
    {
      "start": 228,
      "end": 231,
      "text": "कि तु कौन है और कहां से आया है"
    },
    {
      "start": 231,
      "end": 233,
      "text": "जैसे ही अगनी देव"
    },
    {
      "start": 233,
      "end": 234,
      "text": "अपनी"
    },
    {
      "start": 234,
      "end": 237,
      "text": "उसकी तरफ बढ़ते हैं"
    },
    {
      "start": 237,
      "end": 239,
      "text": "और उससे यह प्रशन पूछते हैं"
    },
    {
      "start": 239,
      "end": 241,
      "text": "तो वह कहता है कि"
    },
    {
      "start": 241,
      "end": 242,
      "text": "मैं तो एक साधरन सा यक्ष हूँ"
    },
    {
      "start": 242,
      "end": 244,
      "text": "आप बताएं आप कौन है"
    },
    {
      "start": 244,
      "end": 247,
      "text": "तो अगनी देव अपना परीचे इस प्रकार देता है"
    },
    {
      "start": 247,
      "end": 249,
      "text": "कि मैं वह हूँ जो इस संसार को"
    },
    {
      "start": 249,
      "end": 251,
      "text": "जला सकता है जो इस संसार को"
    },
    {
      "start": 251,
      "end": 253,
      "text": "एक एक शन में भस्मा कर सकता है"
    },
    {
      "start": 253,
      "end": 255,
      "text": "तब वह यक्ष कहता है"
    },
    {
      "start": 255,
      "end": 257,
      "text": "कि है देव आप इतने"
    },
    {
      "start": 257,
      "end": 259,
      "text": "शक्ति शाली हैं तो क्या आप"
    },
    {
      "start": 259,
      "end": 262,
      "text": "इस छोटे से तिनके को भस्मा कर सकते हैं"
    },
    {
      "start": 262,
      "end": 264,
      "text": "अगने देव पहले मुस्कुराते हैं"
    },
    {
      "start": 264,
      "end": 265,
      "text": "वाले यह तो बड़ा आसान है"
    },
    {
      "start": 265,
      "end": 268,
      "text": "और वो उससे जलाने के लिए"
    },
    {
      "start": 268,
      "end": 270,
      "text": "अपनी शक्ति का इस्तेमाल करते हैं"
    },
    {
      "start": 270,
      "end": 272,
      "text": "परन्तु वो तरन जो है"
    },
    {
      "start": 272,
      "end": 274,
      "text": "वो जो एक तिनका है"
    },
    {
      "start": 274,
      "end": 276,
      "text": "वो जलता ही नहीं है"
    },
    {
      "start": 276,
      "end": 277,
      "text": "वो वैसा का वैसा ही होता है"
    },
    {
      "start": 277,
      "end": 280,
      "text": "अगने देव और ज़्यादा शक्ति का इस्तेमाल करते हैं"
    },
    {
      "start": 280,
      "end": 284,
      "text": "वो अपने प्रचंड रूप में आकर उस तिनके को जलाने की कोशिश करते हैं"
    },
    {
      "start": 284,
      "end": 286,
      "text": "पर वो तिनका वैसा ही रहता है"
    },
    {
      "start": 286,
      "end": 292,
      "text": "अब अगने देव अपनी सारी शक्तियां लगाने के बाद भी जो उस तिनके को जलाने ही पाते हैं"
    },
    {
      "start": 292,
      "end": 294,
      "text": "तो वो हार कर इंद्रदेव के पास आते हैं"
    },
    {
      "start": 294,
      "end": 299,
      "text": "और कहते हैं मैं तो ना जान सका और ना मैं समच सका"
    },
    {
      "start": 299,
      "end": 304,
      "text": "तो इंद्रदेव वरुन देवता को कहते हैं"
    },
    {
      "start": 304,
      "end": 307,
      "text": "वायु देव को कहते हैं कि आप जाए और आप पता करें"
    },
    {
      "start": 307,
      "end": 311,
      "text": "अब वायु देव आते हैं फिर वही प्रशना वो पूछते हैं"
    },
    {
      "start": 311,
      "end": 315,
      "text": "तो यक्ष कहते हैं कि मैं तो वह साधान यक्ष हूँ"
    },
    {
      "start": 315,
      "end": 316,
      "text": "पर आप बताएं आप को ने"
    },
    {
      "start": 316,
      "end": 318,
      "text": "तो वो अपना परिचे देते हैं"
    },
    {
      "start": 318,
      "end": 320,
      "text": "इस समस्त संसार में जो कुछ भी है"
    },
    {
      "start": 320,
      "end": 321,
      "text": "उसे मैं जड़ से उखार सकता हूँ"
    },
    {
      "start": 321,
      "end": 323,
      "text": "मैं उसे उड़ा सकता हूँ"
    },
    {
      "start": 323,
      "end": 325,
      "text": "और मैं उसे समाप्त कर सकता हूँ"
    },
    {
      "start": 325,
      "end": 328,
      "text": "तो वो कहते हैं ठीक है यह एक छोटा सा तिनका है"
    },
    {
      "start": 328,
      "end": 330,
      "text": "आप इसे उड़ा कर दिखाएं"
    },
    {
      "start": 330,
      "end": 334,
      "text": "तो बायु दे पहले अपनी छोटी सी शक्ति का इस्तेमाल करते हैं"
    },
    {
      "start": 334,
      "end": 335,
      "text": "पर वो तिनका हिलता तक नहीं है"
    },
    {
      "start": 335,
      "end": 340,
      "text": "अपनी प्रचंड शक्ति का इस्तेमाल करने के पाद भी जब उस तिनके को नहीं हटा बातें"
    },
    {
      "start": 340,
      "end": 343,
      "text": "तो फिर वो इंदर के पास आते हैं कि देवराज मैं तो ना कर सका"
    },
    {
      "start": 343,
      "end": 346,
      "text": "तब इंदरदेव स्वयम जाते हैं"
    },
    {
      "start": 346,
      "end": 349,
      "text": "कि अब मैं खुद ही जाकर देखता हूँ कि यह कौन है"
    },
    {
      "start": 349,
      "end": 352,
      "text": "जैसे ही इंदरदेव उनके समीप आने लगते हैं"
    },
    {
      "start": 352,
      "end": 355,
      "text": "वह यक्ष वहां से अंतरध्यान हो जाते हैं"
    },
    {
      "start": 355,
      "end": 357,
      "text": "तो इंदरवने खोजने लगते हैं"
    },
    {
      "start": 357,
      "end": 360,
      "text": "जब वो खोचते खोचते एक दूरी पर पहुंचते हैं"
    },
    {
      "start": 360,
      "end": 365,
      "text": "तो उन्हें वहाँ पर एक देवी हिमावती के दर्शन होते हैं"
    },
    {
      "start": 365,
      "end": 366,
      "text": "जब वो माता से पूछते हैं कि है माते"
    },
    {
      "start": 366,
      "end": 369,
      "text": "क्या आपने किसी यक्ष को यहां पर देखा"
    },
    {
      "start": 369,
      "end": 371,
      "text": "तो वो माता कहते हैं"
    },
    {
      "start": 371,
      "end": 373,
      "text": "कि जिन्हें तुम यक्ष समझ रहे हो यक्ष नहीं"
    },
    {
      "start": 373,
      "end": 374,
      "text": "वो परब्रम्म है"
    },
    {
      "start": 374,
      "end": 376,
      "text": "जिसकी शक्तियों से"
    },
    {
      "start": 376,
      "end": 381,
      "text": "और जिसके कारण आज आप यहां पर हैं"
    },
    {
      "start": 381,
      "end": 382,
      "text": "तो वो कहते हैं कि है माते"
    },
    {
      "start": 382,
      "end": 384,
      "text": "मैं तो उसे ना मैं ना ही"
    },
    {
      "start": 384,
      "end": 387,
      "text": "मेरे साथ के अन्यदेवता"
    },
    {
      "start": 387,
      "end": 388,
      "text": "उसे ना समझ ना सके"
    },
    {
      "start": 388,
      "end": 392,
      "text": "तो क्या आप मुझे उनके दर्शन करा सकती हैं"
    },
    {
      "start": 392,
      "end": 393,
      "text": "तब वो कहते हैं कि"
    },
    {
      "start": 393,
      "end": 394,
      "text": "मैं आपको दर्शन भी करा सकती हूं"
    },
    {
      "start": 394,
      "end": 396,
      "text": "परन्तु आपको"
    },
    {
      "start": 396,
      "end": 399,
      "text": "मेरे कहे अनुसार कारे करना होगा"
    },
    {
      "start": 399,
      "end": 401,
      "text": "तो कहते हैं ठीक है"
    },
    {
      "start": 401,
      "end": 403,
      "text": "मैं आपको अपना गूरु से कारता हूं"
    },
    {
      "start": 403,
      "end": 406,
      "text": "और तब वो माता उन्हें परम"
    },
    {
      "start": 406,
      "end": 409,
      "text": "उस ब्रह्म्ह की प्राप्ति कैसे हो"
    },
    {
      "start": 409,
      "end": 411,
      "text": "उसका ज्यान देती हैं"
    },
    {
      "start": 411,
      "end": 413,
      "text": "जब इंद्रदेव"
    },
    {
      "start": 413,
      "end": 416,
      "text": "उनके कही बातों का अनुसरन करते हैं"
    },
    {
      "start": 416,
      "end": 418,
      "text": "तब उन्हें वो परब्रह्म्ह की प्राप्ति होती है"
    },
    {
      "start": 418,
      "end": 421,
      "text": "और जैसे ही वो परब्रह्म्ह की प्राप्ति करते हैं"
    },
    {
      "start": 421,
      "end": 422,
      "text": "वो यह जान जाते हैं"
    },
    {
      "start": 422,
      "end": 424,
      "text": "कि यह सारी शक्तियां जो मेरे पास है"
    },
    {
      "start": 424,
      "end": 426,
      "text": "वो उसी की दी हुई है"
    },
    {
      "start": 426,
      "end": 428,
      "text": "और फिर जब सर्वप्रतम"
    },
    {
      "start": 428,
      "end": 430,
      "text": "वो उन्हें जानते हैं"
    },
    {
      "start": 430,
      "end": 432,
      "text": "फिर अपने साथ के सारे देवताओं को सिखाते हैं"
    },
    {
      "start": 432,
      "end": 436,
      "text": "और तब ब्रह्म्ह पुन्ह उनके सामने"
    },
    {
      "start": 436,
      "end": 439,
      "text": "प्रकट होकर उन्हें आशिरवात प्रदान करते हैं"
    },
    {
      "start": 439,
      "end": 440,
      "text": "और कहते हैं"
    },
    {
      "start": 440,
      "end": 442,
      "text": "कि इस चर अचर में जो कुछ भी है"
    },
    {
      "start": 442,
      "end": 445,
      "text": "जो कुछ भी इस थावर जंगम में है"
    },
    {
      "start": 445,
      "end": 449,
      "text": "जो कुछ भी इस इन लोकों में है"
    },
    {
      "start": 449,
      "end": 451,
      "text": "वह सब मुझे में समाईए थे"
    },
    {
      "start": 451,
      "end": 453,
      "text": "और उन सब में मेरी ही शक्ती समाईए थे"
    },
    {
      "start": 453,
      "end": 456,
      "text": "यदि यहां कुछ भी गटित होता है"
    },
    {
      "start": 456,
      "end": 457,
      "text": "या गटित नहीं होता है"
    },
    {
      "start": 457,
      "end": 460,
      "text": "तो वह सिर्फ और सिर्फ मेरी इच्छा पर ही निरधारी थे"
    },
    {
      "start": 460,
      "end": 464,
      "text": "इस प्रकार का वह उन्हें उपदेश देते हैं"
    },
    {
      "start": 464,
      "end": 466,
      "text": "और वहां से अंतर ध्यान होते हैं"
    },
    {
      "start": 467,
      "end": 472,
      "text": "तो अब हम इस कथा से यह समझते हैं"
    },
    {
      "start": 472,
      "end": 476,
      "text": "कि जब तक देवताओं को भी गुरु प्राप्त नहीं हुए"
    },
    {
      "start": 476,
      "end": 479,
      "text": "जब तक उन देवताओं ने भी गुरु की शरण नहीं ली"
    },
    {
      "start": 479,
      "end": 482,
      "text": "तब तक वो उस परम को नहीं जान सके"
    },
    {
      "start": 482,
      "end": 484,
      "text": "तो हम मनुष्यों की बात ही गया"
    },
    {
      "start": 484,
      "end": 487,
      "text": "इसलिए इस उपनिशद में गुरु महिमा के उपर"
    },
    {
      "start": 487,
      "end": 492,
      "text": "गुरु सानिध्य के उपर और गुरु के अनुसरण के उपर"
    },
    {
      "start": 492,
      "end": 497,
      "text": "बहुत छोटे और बहुत कम शब्दों में"
    },
    {
      "start": 497,
      "end": 499,
      "text": "परन्तु बहुत गुर्टा से बात की गई है"
    },
    {
      "start": 499,
      "end": 500,
      "text": "जैस स्यारा"
    }
  ]
}