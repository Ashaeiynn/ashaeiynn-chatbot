  "language": "hi",
  "minutes": 19,
  "segments": [
    {
      "start": 0,
      "end": 30,
      "text": "पहले पहले पहले पहले पहले कोई पहले जिसको कोई सवाल है मैंने जो समझाया आपको समझाया बहुत सवाल था कि अगर हम अभी राम हवन करते हैं और राम मुंत्र साथना भी कर रहे हैं तो जैसी राम के जाब के साथ-साथ मन में राम राम भी बोल सकते हैं हाद उसे चेह"
    },
    {
      "start": 30,
      "end": 46,
      "text": "और बताइए लगा अवन की अगनी को देख करके जाब कर सकते हैं या बाबा की फोटो को यह करना है यह मसकरी कर रहे हो गया है है"
    },
    {
      "start": 46,
      "end": 76,
      "text": "आपको वही करना है जो बताएगे हाँ साइड में आगर आवन आप और करके रख सकते हैं बीच में अगर देखना हो तो देख सकते हैं पर हाँ जो आपको बताए है वैसे कर यह और ठीक और यह जोर जोर से बोलके स्कीमें मत बताओ लोगों को तुमारी शक्ति जारी इसमे"
    },
    {
      "start": 76,
      "end": 88,
      "text": "क्या मैं दुबारा संकल प्ले सकता हूं किसका रहें गया है आज सुबह मैं शाम को साथ बजे का समझा था विवे कुल से तो वही आप तो कली आना फिर"
    },
    {
      "start": 88,
      "end": 102,
      "text": "कल सब्सक्राइब कल सब्सक्राइब कल सब्सक्राइब कल सब्सक्राइब कर दो"
    },
    {
      "start": 102,
      "end": 132,
      "text": "कि अगर अगर अगर अगर अगर अगर अगर अगर अगर अगर अगर अगर आप जब करें जो जब कर सकते करें जो अपना काम कर रहें काम करें ठीक है हम हम अपना काम करेंगे आप भी अपना"
    },
    {
      "start": 132,
      "end": 148,
      "text": "करें करें देखिए महिमा तो उस शक्तिक यह जिसने सब कुछ बनाया रचित किया यहां पर संत महत्मा जब आप यह बैठते तो कितने संत महत्मा अपना काम करतें कितनी आउती दें उसी परकार से हम सब"
    },
    {
      "start": 148,
      "end": 168,
      "text": "करम करम से नहीं पीछे अटना है आप सभी अपना करम निभाएं फर्ज निभाएं और फर्ज निभाकर दान करें किसी से उधार लेकर मत करें किसी से इर्शाय लेकर मत करें और एहंकार वश्मना करें कि इसने इतना कर दिये तो मैं इतना करूंगा नहीं"
    },
    {
      "start": 168,
      "end": 184,
      "text": "आपका और बाबा का सिरुफ एक संकल्प होना चाहिए उसी संकल्प के साथ अपरें दूसरा आज से एक संकल्प बनाएं आज जो आप रातना करेंगे संकल्प लेंगे वह संकल्प आपकी"
    },
    {
      "start": 184,
      "end": 214,
      "text": "संकल्प की पूर्ति आवश्चे मावी होगी एक तो आज का दिन और एक अक्षेत रित्य का दिन होता है कि दो ही दिन होते हैं जो जिस दिन आप किसी भी संकल्प को अगर आप आरब करें तो पूनता की तरफ आता ही आता है क्योंकि उसमें देवता साहता करतें यह दो दिन"
    },
    {
      "start": 214,
      "end": 231,
      "text": "सब कुछ होगा अभी अभी आउती करने दो चीक है बलाओ स्रीकुरुदेव जिसको नेगेटिविटी से समस्या जिसको और समस्या वह बैटे करपा हो जाएगी जैश्याराम जैश्याराम"
    },
