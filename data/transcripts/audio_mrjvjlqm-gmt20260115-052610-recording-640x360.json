  "segments": [
    {
      "start": 0,
      "end": 30,
      "text": "बताईए वहनी"
    },
    {
      "start": 30,
      "end": 60,
      "text": "रंग एकदम सफेद जैसे आप लोगों ने पहना वैसे दो दूथ दीखे की संत दीके कौन थे नहीं समझ मैं संत ही लग रहे थे और फिर जो दीपक मैं आज संत दीखे वो बिल्कुल वो भी वाइट कलर का ही कपड़ा पहने थे और हनुमान जी और राम जी की तरफ दे मतल�"
    },
    {
      "start": 60,
      "end": 83,
      "text": "अब बहुत है अब बता है भाई वह अब यह अब यह दो माला वाले थे वह उनकी कंप्लीट कंप्लीट अब जिनकी रह गई हो एक मिनटे एक मिनटे एक मिनटे जाना हुआ है"
    },
    {
      "start": 83,
      "end": 96,
      "text": "अब जाना भी होता है सुवएक थाइम लगों को बिलकुल आपने लगवाते हैं"
    },
    {
      "start": 96,
      "end": 126,
      "text": "अब जाना होती है ना तो सबीको साथ में लेकर चलना बड़ता है क्योंकि जिसका रह गया है ना वह एक्जाम की तरह ठीक है वह बोलेगा कि भाई थोड़ा रह गया थोड़ा और जिसका रह जाता है ना उसको रहता है कि साथना पूर्ण हो जाए तो ही वो उठें ठीक है �"
    },
    {
      "start": 126,
      "end": 135,
      "text": "साथ में लेकर चलें आप भी सबीको साथ में लेकर चलें ठीक है सबके बारे में बराबर सोचें क्योंकि कोई जल्दी कर लेता है कोई लेट कर पाता है ठीक है"
    },
    {
      "start": 135,
      "end": 137,
      "text": "अब"
    },
    {
      "start": 137,
      "end": 140,
      "text": "कर दो"
