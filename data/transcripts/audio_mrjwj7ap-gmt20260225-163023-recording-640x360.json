    },
    {
      "start": 311,
      "end": 313,
      "text": "ऐसे टर्न करते हैं वक्त जैसे कितना फास्ट होता"
    },
    {
      "start": 313,
      "end": 315,
      "text": "ना वैसे दिख रहा था"
    },
    {
      "start": 315,
      "end": 321,
      "text": "मतलब आनिमल्स फिर फ्लावर्स फिर बहुत-बहुत कुछ एक से पीछे एक भी खराता था"
    },
    {
      "start": 321,
      "end": 327,
      "text": "पिर ना वैया उसके बाद थोड़ी देर के बाद वह थम दोने के बाद"
    },
    {
      "start": 327,
      "end": 335,
      "text": "मैं एक अंदर गई कहीं बेटो और वहां के ना यह चालू था"
    },
    {
      "start": 335,
      "end": 337,
      "text": "यह चालू था"
    },
    {
      "start": 337,
      "end": 346,
      "text": "जहां में अगनी देव मतलब अगनी जो चलती है हवन की वह वह अगनी कुंड से अलग थी"
    },
    {
      "start": 346,
      "end": 355,
      "text": "मतलब एक गैप था अगनी और अगनी कुंड में और ना वह जो वह हवन कर रहे थे"
    },
    {
      "start": 355,
      "end": 365,
      "text": "वह बड़े विशाल रूप में थे और उन्होंने पेटा पहना था मतलब हमारे वराठी शादियों में पेटा नहीं पहनते हैं पर डेली उपी साइड में पेटा पहनते हैं"
    },
    {
      "start": 365,
      "end": 388,
      "text": "बड़ी बड़ी मूच्छे थी और बड़े विशाल थे बड़े विशाल थे और ना उनके पीछे भी जो रोश्नी थी पूरी गोल्डन कलर की थी जैसे उनका बड़ा और और वो बस एक ही ध्यान करके पूरा वह यग्य कर रहें कर रहें कई सालों से कर रहें"
    },
    {
      "start": 388,
      "end": 412,
      "text": "बड़ा ऐसे समझ में आ रहा था और ना बहुत रोना आ रहा है कि मुझे समझ में क्यों नहीं आया कि मुझे वहां पर जाके क्या करना चाहिए था"
    },
    {
      "start": 412,
      "end": 442,
      "text": "पर बस भाई ध्यान तूट गया मेरा इतना ही सेशन में अभी पंद्रा मिनिट में देख पाई लिए बाबा ने पंद्रा मिनिटे आपको काफी कुछ दिखा दिया बाबा ने बिलकुल जहां पर आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आ"
    },
    {
      "start": 442,
      "end": 472,
      "text": "अपने आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आप आ�"
