      "text": "गोल्डन"
    },
    {
      "start": 283,
      "end": 285,
      "text": "इसमें से"
    },
    {
      "start": 285,
      "end": 287,
      "text": "एक पॉर्टल जैसा खुला"
    },
    {
      "start": 287,
      "end": 289,
      "text": "और मैं वहां"
    },
    {
      "start": 289,
      "end": 291,
      "text": "से अंदर जाने के कोशिश कर रही थी"
    },
    {
      "start": 291,
      "end": 293,
      "text": "लेकिन अंदर जाने के अलावा"
    },
    {
      "start": 293,
      "end": 295,
      "text": "वही से कुछ बाहरा आ रहा था हुए"
    },
    {
      "start": 295,
      "end": 297,
      "text": "अधा"
    },
    {
      "start": 297,
      "end": 299,
      "text": "और बहुत कुछ दिखा"
    },
    {
      "start": 299,
      "end": 301,
      "text": "मतलब आ रहा था"
    },
    {
      "start": 301,
      "end": 303,
      "text": "आते जा रहा था"
    },
    {
      "start": 303,
      "end": 305,
      "text": "बहुत कुछ जैसे"
    },
    {
      "start": 305,
      "end": 307,
      "text": "पेपर पे"
    },
    {
      "start": 307,
      "end": 309,
      "text": "जैसे इमेजिस हम लोग"
    },
    {
      "start": 309,
